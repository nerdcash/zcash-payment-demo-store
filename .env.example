# Store process. Copy this file to .env for `npm run dev`.
# Docker Compose reads the same file for ${VAR} substitution.
PORT=3000
DATABASE_PATH=data/store.db
ZCASH_PAYMENT_SERVICE_BASE_URL=http://127.0.0.1:8787

# Shared with the payment service. Use a long random string before you
# expose the store beyond your machine. This placeholder is not a secret.
ZCASH_WEBHOOK_SECRET=replace-with-a-long-random-string

# Payment service (docker compose). The store does not read these.
# Put your Unified Incoming Viewing Key here. Never commit a real key.
# A viewing key lets the service see incoming notes. It cannot spend them.
ZCASH_NETWORK=testnet
ZCASH_UIVK=
ZCASH_BIRTHDAY_HEIGHT=
LIGHTWALLETD_URL=https://testnet.lightwalletd.com:9067
